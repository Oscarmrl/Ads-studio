# ── Dependencias ───────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ────────────────────────────────────────────────────────
/.next/
/out/
/build

# ── TypeScript ─────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Variables de entorno ────────────────────────────────────────────
.env*

# ── Datos de runtime (generados por la app, no pertenecen al repo) ─
/data/projects/          # Proyectos JSON (datos personales)
/data/outputs/           # Videos MP4 generados

# ── Uploads del usuario ────────────────────────────────────────────
/uploads/voice/          # Voces AI confirmadas
# uploads/sounds/ se versiona con .gitkeep para preservar la carpeta

# ── Archivos públicos generados ────────────────────────────────────
/public/ads/             # HTMLs subidos por el usuario
/public/previews/        # Previews temporales de voces (se limpian solos)

# ── Misc ───────────────────────────────────────────────────────────
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
/coverage
